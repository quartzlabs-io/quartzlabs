# Refuse any release published less than seven days ago (ADR-0003).
#
# This lived only in a machine-local ~/.npmrc, which meant the policy the
# repository documents was not the policy a clone or CI actually ran. A control
# that depends on one developer's laptop is a preference, not a control.
min-release-age=7

# A dependency's install hook is the exact mechanism the quarantine exists for:
# it runs during installation, before anything is imported. Enabled here, where
# the fallout can be verified, rather than machine-wide where it silently breaks
# unrelated projects that build native binaries.
#
# Note it also disables THIS package's own lifecycle scripts. `pretest` stopped
# firing the moment this line landed, and the suite began verifying a stale
# build; the chain is spelled out in `test` rather than implied by a prefix.
ignore-scripts=true
