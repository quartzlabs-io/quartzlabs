---
import "../styles/global.css";
import { company } from "../data/company";

interface Props {
  title: string;
  description: string;
  /* For pages that exist to be served rather than found. The 404 status does the
   * real work, but a page reachable at a URL can still be crawled, and a page
   * that says "not found" while advertising itself as canonical is telling two
   * different stories to the same robot. */
  noindex?: boolean;
  /* Extra JSON-LD for a page that describes something the Organization does not.
   * The products live here rather than in the shared block because they belong
   * to the page that describes them, and a crawler that reads them on /privacy
   * learns nothing it can attach to. */
  schemas?: object[];
}

const { title, description, noindex = false, schemas = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://quartzlabs.io");

/**
 * Answer-engine payload. Assistants and crawlers read this before the prose, so it
 * carries the CNPJ, which is what ties this domain to a registered company. No
 * address, no region, no phone: none of it is needed for that link to hold.
 */
const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://quartzlabs.io/#organization",
  name: company.brand,
  description: company.summary,
  url: "https://quartzlabs.io",
  email: company.email,
  taxID: company.taxId,
  areaServed: "Worldwide",
  knowsAbout: company.knowsAbout,
  sameAs: [company.github],
  /* What a search engine draws on an entity card. It will not take the SVG, and
   * it had nothing else to take: the mark existed as a favicon and as the share
   * image and neither was ever declared as the company's logo. */
  logo: {
    "@type": "ImageObject",
    url: "https://quartzlabs.io/logo.png",
    width: 512,
    height: 512,
  },
};

/* Breadcrumbs for anything that is not the home page. One level deep, which is
 * the whole hierarchy, and it is what puts a path under the result instead of a
 * bare URL. */
const trail =
  canonical.pathname === "/"
    ? null
    : {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
          {
            "@type": "ListItem",
            position: 1,
            name: company.brand,
            item: "https://quartzlabs.io",
          },
          {
            "@type": "ListItem",
            position: 2,
            name: title.split(" — ")[0],
            item: canonical.href,
          },
        ],
      };

const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://quartzlabs.io/#website",
  url: "https://quartzlabs.io",
  name: company.brand,
  inLanguage: "en",
  publisher: { "@id": "https://quartzlabs.io/#organization" },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      noindex ? (
        <meta name="robots" content="noindex, follow" />
      ) : (
        <link rel="canonical" href={canonical.href} />
      )
    }

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {
      /* The SVG is the icon; the rasters are for the places that cannot take one.
        Safari before 16 ignores an SVG favicon entirely, and iOS uses
        apple-touch-icon for the home screen, squares it and drops transparency,
        so that file is full-bleed on black rather than a transparent mark.

        48 and 192 exist for Google. Their guideline asks for a square favicon
        larger than 48x48, and 32 was the largest raster this page offered, which
        was the one guideline the site missed. It does not make the crawl any
        faster: Googlebot-Image fetches the icon on its own pass, days to weeks
        after the page is indexed. */
    }
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="icon" href="/favicon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      href="/fonts/instrument-sans-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/ibm-plex-mono-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content={company.brand} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={new URL("/og.png", canonical).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${company.brand} — ${company.metaDescription}`}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="color-scheme" content="light dark" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(organization)}
      is:inline
    />
    <script type="application/ld+json" set:html={JSON.stringify(website)} is:inline />
    {
      trail && (
        <script type="application/ld+json" set:html={JSON.stringify(trail)} is:inline />
      )
    }
    {
      schemas.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
      ))
    }

    <!-- The whole enhancement, deliberately in ONE script: it both arms the hidden
         state (before first paint, so nothing flashes in and then hides) and
         disarms it on any failure. Split across head and body-end, a truncated
         response leaves the page armed with nothing left to reveal it, which is
         exactly the invisible-content bug this replaced. One script cannot
         desync from itself. Blocked by CSP, or reduced motion on: no class, no
         hidden state, everything visible. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        /* Reduced motion turns off animation. It says nothing about clipboards, so
           the copy button is armed on both paths and only the motion work below
           is skipped. Reading the query once keeps the two decisions separate. */
        var reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (!reduced) root.classList.add("js-reveal");

        var start = function () {
          try {
            var copy = document.querySelector("[data-copy]");
            if (copy && navigator.clipboard) {
              var label = copy.querySelector("[data-copy-label]");
              var idle = label.textContent;
              var settle;
              copy.classList.add("is-ready");
              copy.addEventListener("click", function () {
                navigator.clipboard
                  .writeText(copy.getAttribute("data-copy"))
                  .then(function () {
                    label.textContent = "Copied";
                    copy.classList.add("is-copied");
                    clearTimeout(settle);
                    settle = setTimeout(function () {
                      label.textContent = idle;
                      copy.classList.remove("is-copied");
                    }, 1600);
                  });
              });
            }

            if (reduced) return;
            if (!("IntersectionObserver" in window)) throw 0;

            var io = new IntersectionObserver(
              function (entries) {
                for (var i = 0; i < entries.length; i++) {
                  if (entries[i].isIntersecting) {
                    entries[i].target.classList.add("is-visible");
                    io.unobserve(entries[i].target);
                  }
                }
              },
              { rootMargin: "0px 0px -8% 0px" }
            );
            document.querySelectorAll("[data-reveal]").forEach(function (el) {
              io.observe(el);
            });

            var header = document.querySelector(".site-header");
            if (header) {
              var dock = function () {
                header.classList.toggle("is-docked", window.scrollY > 24);
              };
              dock();
              addEventListener("scroll", dock, { passive: true });
            }
          } catch (e) {
            /* Whatever broke, the content must not stay invisible. */
            root.classList.remove("js-reveal");
          }
        };

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", start);
        } else {
          start();
        }
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
