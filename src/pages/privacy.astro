---
import Prose from "../layouts/Prose.astro";
import { company } from "../data/company";

/* Required before either application can be submitted to a store, and worth
   having regardless. Every claim here is one the site can be checked against.
   The CSP in public/_headers is `default-src 'none'`, and a test fails the
   build if any third-party origin appears in the output. */
const sections = [
  {
    heading: "This site",
    body: "It sets no cookies, runs no analytics, and asks nothing of any other server. The fonts come from this domain, and the page declares a policy that tells the browser to refuse every request it does not already need. Nothing about your visit is written to your browser.",
  },
  {
    heading: "What the host records",
    body: "The site is served by Cloudflare, which keeps the ordinary records any web server keeps: the address a request came from, the page asked for, the time, and whatever the browser says about itself. Those records are not used to build a picture of anyone, and they are not passed on.",
  },
  {
    heading: "If you write",
    body: "The message arrives in a mailbox with whatever you put in it, including the address you sent it from. It is used to answer you and to keep the thread. It goes on no mailing list and it is shown to nobody else.",
  },
  {
    heading: "The applications",
    body: "Voltz Wallet and Nyx Wallet are separate software and neither has been released. What an application does with data on a device is a different question from what a website does, so each will publish its own policy alongside it rather than being described here.",
  },
];
---

<Prose
  title="Privacy"
  heading="Privacy"
  description="What this site collects, which is nothing, and what happens to an email sent to Quartz Labs."
  updated="19 August 2026"
>
  {
    sections.map((s) => (
      <div>
        <h2 class="type-heading">{s.heading}</h2>
        <p class="text-ink-2 type-body mt-4">{s.body}</p>
      </div>
    ))
  }
  <div>
    <h2 class="type-heading">Questions</h2>
    <p class="text-ink-2 type-body mt-4">
      Write to <a href={`mailto:${company.email}`} class="prose-link">{company.email}</a>.
    </p>
  </div>
</Prose>
