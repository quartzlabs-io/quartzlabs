# Served by the Cloudflare Worker that hosts the static assets. Astro copies this
# file into dist/ verbatim.

/*
  # The site fetches nothing from anywhere: no analytics, no font CDN, no embeds.
  # `default-src 'none'` states that, and every allowance below is one this page
  # actually uses.
  #
  # script-src keeps 'unsafe-inline' on purpose. The alternative is hashing the
  # inline blocks, but CSP Level 3 makes hashes override 'unsafe-inline'
  # entirely, and the JSON-LD blocks are also <script> elements. Browsers differ
  # on whether a non-executable data block is subject to script-src, and losing
  # the structured data would cost more than this buys: the page has no user
  # input and no dynamic rendering, so the injection surface this would close is
  # already empty. What remains enforced is the part that matters here, which is
  # that no script from another origin can load at all.
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Frame-Options: DENY

# Astro fingerprints these filenames, so a changed file is a changed URL.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Not fingerprinted. Safe as immutable only because replacing a face means
# renaming the file, never overwriting it.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Revalidate the documents so a deploy is visible immediately.
/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate
